{
  "name": "tarot-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "smoke:metro": "expo start --offline --port 8125",
    "eas:login": "npx --yes eas-cli@12 login",
    "eas:whoami": "npx --yes eas-cli@12 whoami",
    "eas:configure": "npx --yes eas-cli@12 build:configure",
    "eas:token": "npx --yes eas-cli@12 token:create",
    "eas:setup": "npm run eas:login && npm run eas:whoami && npm run eas:configure",
    "eas:build:preview:android": "npx --yes eas-cli@12 build --platform android --profile preview",
    "eas:build:preview:all": "npx --yes eas-cli@12 build --platform all --profile preview",
    "eas:build:production:all": "npx --yes eas-cli@12 build --platform all --profile production",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.0.2",
    "expo": "55.0.24",
    "expo-router": "55.0.14",
    "expo-secure-store": "55.0.14",
    "expo-sqlite": "55.0.16",
    "nativewind": "4.2.3",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.14",
    "jest": "29.7.0",
    "jest-expo": "55.0.17",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
